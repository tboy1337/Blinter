{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blinter.dev/schema/commands-linter.schema.json",
  "title": "Blinter linter command policy",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "dangerous_command_names": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dangerous_command_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "rule_code"],
        "properties": {
          "pattern": { "type": "string" },
          "rule_code": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "command_casing_keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sensitive_keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "architecture_specific_patterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unicode_problematic_commands": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
