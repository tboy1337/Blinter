[MAIN]
jobs = 0

[MESSAGES CONTROL]
# disable replaces pylint's list rather than appending; keep 4.0 defaults plus
# the four extras this repo needs.
disable = raw-checker-failed,
          bad-inline-option,
          locally-disabled,
          file-ignored,
          suppressed-message,
          useless-suppression,
          deprecated-pragma,
          use-symbolic-message-instead,
          use-implicit-booleaness-not-comparison-to-string,
          use-implicit-booleaness-not-comparison-to-zero,
          too-many-public-methods,
          broad-exception-caught,
          duplicate-code,
          line-too-long
